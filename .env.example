# Base URL of the Express API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Demo must be built in a separate Vercel project. Public NEXT_PUBLIC values
# are embedded in the browser bundle; set the password only after approval.
# NEXT_PUBLIC_APP_ENV=demo
# NEXT_PUBLIC_DEMO_API_URL=https://<demo-render-host>/api/v1
# NEXT_PUBLIC_DEMO_EMAIL=demo@doctortracker.com
# NEXT_PUBLIC_DEMO_PASSWORD=<approved-public-demo-password>
